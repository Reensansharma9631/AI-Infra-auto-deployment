# Pinned inputs for the ONLINE bundle builders. Edit here, nothing else needs changing.
UBUNTU_RELEASE="24.04"
UBUNTU_CODENAME="noble"

# --- Apache CloudStack (4.22 = current LTS line; repo serves the newest 4.22.x) ---
CLOUDSTACK_SERIES="4.22"
CLOUDSTACK_APT_URL="http://download.cloudstack.org/ubuntu"
CLOUDSTACK_GPG_URL="http://download.cloudstack.org/release.asc"
SYSTEMVM_KVM_URL="http://download.cloudstack.org/systemvm/4.22/systemvmtemplate-4.22.0-x86_64-kvm.qcow2.bz2"

# --- OpenStack 2026.1 (Gazpacho) via Kolla-Ansible 22.x ---
KOLLA_RELEASE="2026.1"
KOLLA_ANSIBLE_SPEC="kolla-ansible>=22,<23"
KOLLA_REGISTRY="quay.io/openstack.kolla"
KOLLA_TAG="2026.1-ubuntu-noble"
