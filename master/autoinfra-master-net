#!/usr/bin/env bash
# Master-side network helper, run as root (the AutoInfra service user may run exactly this script via sudoers):
#   autoinfra-master-net dns-update            regenerate the DNS records (dnsmasq) from the host inventory + master, reload
#   autoinfra-master-net routes <gw> <cidr>... persistent routes from the master to CloudStack's internal pod/public subnets
#   autoinfra-master-net routes-clear          remove them
#   autoinfra-master-net run-request           (root, from autoinfra-master-net.path) run the request the service wrote to
#                                              <data>/master-net/request.json and answer in result.json - no sudo needed
# Safe to re-run. Nothing here reaches the network.
set -Eeuo pipefail
ETC="${AUTOINFRA_ETC:-/etc/autoinfra}"; DATA="${AUTOINFRA_DATA:-/var/lib/autoinfra}"; UNIT_DIR="${AUTOINFRA_UNIT_DIR:-/etc/systemd/system}"
sysctl_() { [ "${AUTOINFRA_NO_SYSTEMD:-0}" = 1 ] && return 0; systemctl "$@"; }
if [ -z "${AUTOINFRA_DATA:-}" ] && [ -f "$ETC/autoinfra.env" ]; then DATA="$(sed -n 's/^AUTOINFRA_DATA=//p' "$ETC/autoinfra.env" | tail -1)"; fi; DATA="${DATA:-/var/lib/autoinfra}"
MASTER_IP="${AUTOINFRA_MASTER_IP:-$(sed -n 's/^AUTOINFRA_MASTER_IP=//p' "$ETC/autoinfra.env" 2>/dev/null | tail -1)}"
case "${1:-}" in
dns-update)
  mkdir -p "$ETC/dns"
  {
    echo "# generated by autoinfra-master-net dns-update - $(date -u +%FT%TZ)"
    [ -n "$MASTER_IP" ] && echo "$MASTER_IP autoinfra-master $(hostname -s 2>/dev/null)"
    if [ -f "$DATA/autoinfra.db" ]; then
      # ip hostname (hostnames are validated by the UI: letters, digits, '-' and '.')
      python3 - "$DATA/autoinfra.db" <<'PY'
import sqlite3, sys, re
c = sqlite3.connect(f"file:{sys.argv[1]}?mode=ro", uri=True)
for ip, hn in c.execute("SELECT ip, hostname FROM hosts"):
    if hn and re.fullmatch(r"[A-Za-z0-9][A-Za-z0-9.-]{0,62}", hn):
        print(ip, hn)
PY
    fi
  } > "$ETC/dns/hosts.tmp" && mv "$ETC/dns/hosts.tmp" "$ETC/dns/hosts"
  if [ "${AUTOINFRA_NO_SYSTEMD:-0}" != 1 ] && systemctl is-active --quiet dnsmasq; then systemctl reload dnsmasq 2>/dev/null || kill -HUP "$(systemctl show -p MainPID --value dnsmasq)"; fi
  echo "dns records: $(grep -vc '^#' "$ETC/dns/hosts") host(s)";;
routes)
  gw="${2:?gateway}"; shift 2; [ $# -gt 0 ] || { echo "no routes"; exit 1; }
  for c in "$@"; do [[ "$c" =~ ^[0-9]+\.[0-9]+\.[0-9]+\.[0-9]+/[0-9]+$ ]] || { echo "bad cidr $c" >&2; exit 1; }; done
  [[ "$gw" =~ ^[0-9]+\.[0-9]+\.[0-9]+\.[0-9]+$ ]] || { echo "bad gateway $gw" >&2; exit 1; }
  u="$UNIT_DIR/autoinfra-routes.service"
  {
    echo "# managed by autoinfra-master-net - routes from the master to CloudStack's internal networks"
    printf '[Unit]\nDescription=AutoInfra master routes\nWants=network-online.target\nAfter=network-online.target\n\n[Service]\nType=oneshot\nRemainAfterExit=yes\n'
    for c in "$@"; do echo "ExecStart=/usr/sbin/ip route replace $c via $gw"; done
    for c in "$@"; do echo "ExecStop=-/usr/sbin/ip route del $c via $gw"; done
    printf '\n[Install]\nWantedBy=multi-user.target\n'
  } > "$u.tmp"
  if ! cmp -s "$u.tmp" "$u"; then mv "$u.tmp" "$u"; sysctl_ daemon-reload; sysctl_ enable --now autoinfra-routes.service >/dev/null 2>&1 || true; sysctl_ restart autoinfra-routes.service; echo "routes set: $* via $gw"
  else rm -f "$u.tmp"; sysctl_ start autoinfra-routes.service 2>/dev/null || true; echo "routes unchanged"; fi;;
run-request)
  d="$DATA/master-net"; req="$d/request.json"; [ -f "$req" ] || exit 0
  python3 - "$0" "$req" "$d/result.json" <<'PY'
import json, os, subprocess, sys
me, req, res = sys.argv[1:4]
try:
    r = json.load(open(req)); args = [str(a) for a in r.get("args", [])]; rid = str(r.get("id", ""))
except (OSError, ValueError) as e:
    sys.exit(f"bad request: {e}")
if not args or args[0] not in ("dns-update", "routes", "routes-clear"):
    out, rc = f"refused: {args[:1]}", 1
else:
    p = subprocess.run(["bash", me, *args], capture_output=True, text=True, env=dict(os.environ))
    out, rc = (p.stdout + p.stderr)[-2000:], p.returncode
tmp = res + ".tmp"
with open(tmp, "w") as fh:
    json.dump({"id": rid, "rc": rc, "output": out}, fh)
os.chmod(tmp, 0o644); os.replace(tmp, res)
PY
  ;;
routes-clear)
  sysctl_ disable --now autoinfra-routes.service >/dev/null 2>&1 || true; rm -f "$UNIT_DIR/autoinfra-routes.service"; sysctl_ daemon-reload; echo "routes cleared";;
*) echo "usage: $0 dns-update | routes <gw> <cidr>... | routes-clear | run-request" >&2; exit 1;;
esac
