# managed by AutoInfra
storage:
  dbPath: /var/lib/mongo{{ 'db' if ansible_facts['os_family'] == 'Debian' else '' }}
systemLog:
  destination: file
  logAppend: true
  path: /var/log/mongodb/mongod.log
net:
  port: {{ mongo_port }}
  bindIp: {{ mongo_bind }}
{% if groups['mongodb'] | length > 1 %}
replication:
  replSetName: {{ mongo_replset }}
{% endif %}
