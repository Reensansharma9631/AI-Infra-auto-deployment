# managed by AutoInfra - internal CloudStack bridge {{ kvm_internal_net.bridge }} (pod/public gateway for system VMs)
# The bridge has no physical NIC; a dummy device gives CloudStack a parent for guest VLAN interfaces (aidummy0.<vlan>).
[Unit]
Description=AutoInfra internal network {{ kvm_internal_net.bridge }}
Before=libvirtd.service cloudstack-agent.service
After=network-pre.target
Wants=network-pre.target

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/sbin/sysctl -q -w net.ipv4.ip_forward=1
ExecStart=/bin/sh -c 'ip link show aidummy0 >/dev/null 2>&1 || ip link add aidummy0 type dummy'
ExecStart=/bin/sh -c 'ip link show {{ kvm_internal_net.bridge }} >/dev/null 2>&1 || ip link add {{ kvm_internal_net.bridge }} type bridge'
ExecStart=/usr/sbin/ip link set aidummy0 master {{ kvm_internal_net.bridge }}
ExecStart=/usr/sbin/ip link set aidummy0 up
ExecStart=/usr/sbin/ip link set {{ kvm_internal_net.bridge }} up
{% for a in kvm_internal_net.addresses %}
ExecStart=/usr/sbin/ip addr replace {{ a }} dev {{ kvm_internal_net.bridge }}
{% endfor %}
{% for c in kvm_internal_net.nat_cidrs | default([]) %}
# hosts without a route back (the master, the LAN gateway) see this KVM host's IP
ExecStart=/bin/sh -c 'iptables -t nat -C POSTROUTING -s {{ c }} ! -o {{ kvm_internal_net.bridge }} -j MASQUERADE 2>/dev/null || iptables -t nat -A POSTROUTING -s {{ c }} ! -o {{ kvm_internal_net.bridge }} -j MASQUERADE'
{% endfor %}

[Install]
WantedBy=multi-user.target
