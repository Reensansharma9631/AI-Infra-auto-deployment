# managed by airgap-installer: VIP of the CloudStack management servers
vrrp_script chk_haproxy {
    script "/bin/sh -c 'systemctl is-active --quiet haproxy'"
    interval 2
    fall 2
    rise 1
    weight 60
}

vrrp_instance CS_MGMT_VIP {
    state BACKUP
    interface {{ lb_iface }}
    virtual_router_id {{ cs_mgmt_vrrp_id }}
    priority 100
    advert_int 1
{% set peers = groups['cs_lb'] | map('extract', hostvars, 'ansible_host') | reject('equalto', ansible_host) | list %}
{% if peers %}
    unicast_src_ip {{ ansible_host }}
    unicast_peer {
{% for ip in peers %}
        {{ ip }}
{% endfor %}
    }
{% endif %}
    authentication {
        auth_type PASS
        auth_pass {{ cs_mgmt_vrrp_pass }}
    }
    virtual_ipaddress {
        {{ cs_mgmt_vip }}/{{ cs_mgmt_vip_prefix }} dev {{ lb_iface }}
    }
    track_script {
        chk_haproxy
    }
}
