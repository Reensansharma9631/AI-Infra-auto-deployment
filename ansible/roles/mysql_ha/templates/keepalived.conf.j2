# managed by airgap-installer
global_defs {
    router_id {{ node_hostname }}
    script_user root
    enable_script_security
}

vrrp_script chk_db_primary {
    script "/usr/bin/curl -fsS -m 2 http://{{ ansible_host }}:{{ db_agent_port }}/primary"
    interval 2
    fall 2
    rise 1
    weight 60
}

vrrp_instance DB_VIP {
    state BACKUP
    interface {{ vrrp_iface }}
    virtual_router_id {{ db_vrrp_id }}
    priority 100
    advert_int 1
    unicast_src_ip {{ ansible_host }}
    unicast_peer {
{% for h in groups['cs_db'] if hostvars[h].ansible_host != ansible_host %}
        {{ hostvars[h].ansible_host }}
{% endfor %}
    }
    authentication {
        auth_type PASS
        auth_pass {{ db_vrrp_pass }}
    }
    virtual_ipaddress {
        {{ db_vip }}/{{ db_vip_prefix }} dev {{ vrrp_iface }}
    }
    track_script {
        chk_db_primary
    }
}

# other roles (e.g. cs_lb) drop their VRRP instances here
include /etc/keepalived/conf.d/*.conf
