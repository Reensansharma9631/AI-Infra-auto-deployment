#!/usr/bin/env python3
"""Stand-in for kolla-ansible: checks the generated config files exist and records the action."""
import json, os, sys
a = sys.argv[1:]
action = a[0]
cfg = a[a.index("--configdir") + 1]
for f in ("globals.yml", "multinode", "passwords.yml"):
    assert os.path.isfile(os.path.join(cfg, f)), f"{f} missing"
assert oct(os.stat(os.path.join(cfg, "passwords.yml")).st_mode & 0o777) == "0o600"
log = os.environ.get("FAKE_KOLLA_LOG") or os.path.join(cfg, "kolla-calls.log")
open(log, "a").write(json.dumps({"action": action, "args": a}) + "\n")
if action == "post-deploy":
    open(os.path.join(cfg, "admin-openrc.sh"), "w").write("export OS_AUTH_URL=http://vip:5000\n")
print(f"kolla-ansible {action}: ok")
sys.exit(int(os.environ.get("FAKE_KOLLA_RC_" + action.replace("-", "_"), "0")))
